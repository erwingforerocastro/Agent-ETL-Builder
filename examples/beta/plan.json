{
  "plan_version": "1.0",
  "mode": "pipeline",
  "run_id": "1729850000000-a1b2c3d4",
  "name": "clean_beta_input",
  "description": "Remove duplicate rows, trim whitespace, and save the result as CSV.",
  "source": {
