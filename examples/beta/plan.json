      "step_id": "s1",
      "operation": "drop_duplicate_rows",
      "params": {
        "keep": "first"
      }
    },
    {
      "step_id": "s2",
      "operation": "trim_whitespace",
      "params": {
        "policy": "both"
      }
    }
  ],
  "destination": {
    "operation": "save_csv",
    "params": {
      "path": "beta_output.csv"
    }
  },
  "chunking": {
    "enabled": false,
    "size": 10000
  },
  "on_error": "fail_fast",
  "approval_required": true
}
