AGENT_ETL_SERVICE_NAME=agent-etl-builder
AGENT_ETL_ENVIRONMENT=local
AGENT_ETL_APPROVAL_TIMEOUT_SECONDS=300
AGENT_ETL_CLEANUP_POLICY=cleanup
AGENT_ETL_MAX_REQUEST_BYTES=1000000
# Optional: leave AGENT_ETL_DATABASE_URL unset to run without PostgreSQL.
# AGENT_ETL_DATABASE_URL=postgresql://user:password@127.0.0.1:5432/warehouse
# AGENT_ETL_DATABASE_SSLMODE=prefer
# AGENT_ETL_DATABASE_SSLROOTCERT=C:/certs/root.crt
# AGENT_ETL_DATABASE_CONNECT_TIMEOUT_SECONDS=10
# AGENT_ETL_DATABASE_STATEMENT_TIMEOUT_MS=30000
# AGENT_ETL_DATABASE_APPLICATION_NAME=agent-etl-builder
# Optional: require X-API-Key on /runs routes. Leave unset for local development.
# AGENT_ETL_API_KEY=replace-me
# Optional: enable natural-language planning through a local Ollama server.
# Leave AGENT_ETL_OLLAMA_MODEL unset to disable the agent and use structured plans only.
# AGENT_ETL_OLLAMA_MODEL=llama3.1:8b
# AGENT_ETL_OLLAMA_BASE_URL=http://127.0.0.1:11434
# AGENT_ETL_OLLAMA_TIMEOUT_SECONDS=90
